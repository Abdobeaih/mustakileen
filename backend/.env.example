PORT=5000
MONGODB_URI=mongodb://username:password@localhost:27017/mustakleen?authSource=admin
JWT_SECRET=generate-a-cryptographically-random-64-byte-string-here
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# NodeMailer SMTP (Gmail App Password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_USER=your-gmail-address
EMAIL_PASS=your-gmail-app-password

# Seed script admin account (used only by `node seeds/seed.js`)
SEED_ADMIN_EMAIL=admin-email-for-seeding
SEED_ADMIN_PASSWORD=choose-a-strong-admin-password
